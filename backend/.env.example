# ==============================================================================
# QuantPilot Backend Environment Configuration Template
# Copy this file to .env and replace placeholders with your actual API keys.
# ==============================================================================

# LLM Configuration
# LLM_PROVIDER can be 'google' or 'groq'. If not set, defaults to 'google' if GOOGLE_API_KEY is present.
LLM_PROVIDER=google
# LLM_MODEL_NAME allows you to override the default model for the chosen provider.
# Default for google: gemini-flash-latest
# Default for groq: llama-3.3-70b-versatile
LLM_MODEL_NAME=gemini-flash-latest

# LangSmith observability (optional)
# Set LANGCHAIN_TRACING_V2=true and provide an API key to trace LangGraph,
# LLM, and tool runs in the LangSmith project below.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_api_key
LANGCHAIN_PROJECT=quantpilot
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# LLM API Keys
GOOGLE_API_KEY=your_google_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Database (Supabase / PostgreSQL)
# Example: postgresql://postgres.xxx:password@aws-1-ap-southeast-2.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Market Data Providers
FINNHUB_API_KEY=your_finnhub_api_key_here
ALPHAADVANTAGE_API_KEY=your_alphavantage_api_key_here

# Alpaca OAuth (paper trading only)
ALPACA_CLIENT_ID=your_alpaca_oauth_client_id
ALPACA_CLIENT_SECRET=your_alpaca_oauth_client_secret
ALPACA_REDIRECT_URI=http://localhost:8000/auth/alpaca/callback
ALPACA_OAUTH_SCOPES=trading
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ALPACA_TOKEN_ENCRYPTION_KEY=your_fernet_key

# Frontend and CORS
# Set these to the deployed Vercel URL in Render.
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Supabase authentication
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_service_or_anon_key
